# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local
.env
.env.local
.env.production

# Cloudflare Wrangler local secrets — wrangler dev reads these, NOT .env
.dev.vars
**/.dev.vars

# Local tooling state — wrangler build/cache output and Supabase CLI link state.
# supabase/.temp holds project-ref and pooler-url (a credentialed connection
# string), so this must never be committed.
.wrangler/
**/.wrangler/
supabase/.temp/

# Python (media layer)
__pycache__/
*.py[cod]
.venv/
**/.venv/
*.egg-info/
.pytest_cache/

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Local dev mock of the B2 media index (real index lives in B2)
public/index/

# Generated media output (lives in B2, not git)
out/
media/out/

# Claude Code per-user local settings (personal permission allowlist)
.claude/settings.local.json
