# Media layer environment. Copy to media/.env; gitignored.
# Batch generation only — these are never exposed to the browser.

# Supabase (read-only). Same project as the simulation. The service key is
# preferred so the adapter can read every world; the anon key also works for the
# public live world.
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
SUPABASE_ANON_KEY=

# Backblaze B2 — Account > Application Keys. Scope the key to the media bucket.
B2_KEY_ID=
B2_APP_KEY=
B2_BUCKET=
B2_REGION=

# GMICloud — console.gmicloud.ai. Primary provider: image + video + audio + chat.
GMI_API_KEY=

# Optional fallbacks / dedicated TTS and music.
ELEVENLABS_API_KEY=
STABILITY_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=

# Broadcast voiceover (on-device TTS). Auto-detected in this order: macOS `say`,
# then `espeak-ng`, then `espeak` (install espeak-ng on Linux/Windows). Force one
# with RS_TTS_BACKEND. RS_TTS_VOICE is the `say` voice; RS_ESPEAK_VOICE the espeak one.
RS_TTS_BACKEND=
RS_TTS_VOICE=Rishi
RS_ESPEAK_VOICE=en-gb
