# ─────────────────────────────────────────────────────────────────────────────
# Cloudflare Worker secrets — set via `wrangler secret put <NAME>` or the
# Cloudflare dashboard. NEVER put these in the frontend or in version control.
# ─────────────────────────────────────────────────────────────────────────────

# Groq API key — console.groq.com (free, no credit card required)
# Runs Llama 3.3 70B for all agent calls. Free tier: 1k req/day, 30 rpm.
# Groq retires model IDs without notice — if agent calls 404 with
# model_not_found, list current IDs:
#   curl -H "Authorization: Bearer $GROQ_API_KEY" https://api.groq.com/openai/v1/models
GROQ_API_KEY=

# Optional: swap all LLM calls to Claude by setting this + changing LLM_BASE_URL
# in workers/src/ai/llm.ts. Claude Haiku ~$10-30/month for full simulation.
ANTHROPIC_API_KEY=

# Supabase project URL — found in: Project Settings > API
# Same value as VITE_SUPABASE_URL below; the Worker needs its own copy.
SUPABASE_URL=

# Supabase service role key — found in: Project Settings > API > service_role
# Grants full DB access (bypasses RLS). Used only in the Cloudflare Worker.
SUPABASE_SERVICE_KEY=

# NewsAPI.org free account key — newsapi.org/register
# Used for monthly real-world news injection (Milestone 5).
# The free Developer plan is for development only; production needs a paid
# plan or another source (GDELT is planned — PLAN.md M17).
NEWS_API_KEY=

# Secret header value that protects the /api/agents/run and /api/sync/country
# endpoints from unauthorized calls. Set to any long random string.
WORKER_SECRET=

# Optional — lets the Worker serve media indexes from a PRIVATE B2 bucket
# (GET /api/media/index/:worldId re-presigns every URL on request, so nothing
# expires). Same names as the media layer's B2_* below; a read-only key is enough.
# Set as Worker secrets: B2_KEY_ID, B2_APP_KEY, B2_BUCKET, B2_REGION, and
# optionally B2_S3_ENDPOINT. For a PUBLIC bucket set MEDIA_PUBLIC_BASE instead
# (see workers/wrangler.toml).

# ─────────────────────────────────────────────────────────────────────────────
# Frontend environment variables — safe to expose in the browser bundle.
# Create a .env file in the project root with these values for local dev.
# ─────────────────────────────────────────────────────────────────────────────

# Cesium Ion access token — ion.cesium.com (free account)
# Required for terrain, satellite imagery, and higher API quotas.
# The globe renders without it but with reduced quality.
VITE_CESIUM_ION_TOKEN=

# Supabase project URL — found in: Project Settings > API
VITE_SUPABASE_URL=

# Supabase anon key — found in: Project Settings > API > anon (public)
# Safe to expose; RLS policies protect data access.
VITE_SUPABASE_ANON_KEY=

# URL of your deployed Cloudflare Worker
# Local dev: http://localhost:8787
# Production: https://realityshift-api.<your-subdomain>.workers.dev
VITE_AI_PROXY_URL=http://localhost:8787

# Public base URL of the Backblaze B2 bucket holding generated media.
# The frontend fetches the per-fork media index from:
#   ${VITE_B2_PUBLIC_BASE}/index/{world_id}/media.json
# and streams assets directly from B2 — no Worker or Supabase round-trip.
VITE_B2_PUBLIC_BASE=

# ─────────────────────────────────────────────────────────────────────────────
# Media layer (Python, `media/`) — batch generation only, never the browser.
# Genblaze reads B2_* directly from the environment via
# S3StorageBackend.for_backblaze(). See PLAN.md Milestones 12-15.
# ─────────────────────────────────────────────────────────────────────────────

# Backblaze B2 application key — Account > Application Keys
# Scope the key to the single media bucket, not the whole account.
B2_KEY_ID=
B2_APP_KEY=

# Bucket name and region (e.g. us-west-004).
# Region is an optimization hint — Genblaze auto-detects on redirect — but some
# regions reject cross-region requests with 403 instead of 301, so set it.
B2_BUCKET=
B2_REGION=

# GMICloud — console.gmicloud.ai
# Primary provider: video + image + audio + chat behind one key.
GMI_API_KEY=

# Optional: dedicated anchor TTS if GMICloud's voice quality is insufficient.
ELEVENLABS_API_KEY=

# Optional: news-bed music via Stable Audio.
STABILITY_API_KEY=

# Optional fallback providers for the fallback_models chain.
OPENAI_API_KEY=
GEMINI_API_KEY=
